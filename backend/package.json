{
  "name": "kontrahent-backend",
  "version": "1.0.0",
  "description": "Kontrahent.sk — NestJS Backend API",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main",
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "start:debug": "node --inspect -r ts-node/register src/main.ts",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/throttler": "6.7.1",
    "@supabase/supabase-js": "2.117.3",
    "@types/xml2js": "^0.4.14",
    "adm-zip": "0.6.1",
    "axios": "^1.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/web-push": "^3.6.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
